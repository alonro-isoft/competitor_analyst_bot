# Bridge server port
PORT=3000

# Google Gemini API key used to run the competitor analysis (server-side only — never expose this in client code)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# The OpenWA gateway this bridge talks to.
# When both containers run via the provided docker-compose files on the same
# "openwa-network", the service name "openwa-api" resolves automatically.
OPENWA_BASE_URL=http://openwa-api:2785

# API key with at least OPERATOR role, created via the OpenWA dashboard or
# read from whatsapp-gateway/data/.api-key after the gateway's first boot.
OPENWA_API_KEY=

# The session id created in OpenWA (POST /api/sessions) whose QR code you scanned
# with the WhatsApp account you want connected.
OPENWA_SESSION_ID=

# The same secret you pass as "secret" when registering the webhook
# (POST /api/sessions/:sessionId/webhooks) — used to verify X-OpenWA-Signature.
OPENWA_WEBHOOK_SECRET=
